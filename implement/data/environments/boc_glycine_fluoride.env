# BOC-(13C2-15N-2D2-glycine)-fluoride, 5-qubit NMR molecule
# Reference [16]: R. Marx et al., Phys. Rev. A 60, 2966 (1999)
#
# Nuclei (5):
#   0 = F   (19F acyl fluoride)
#   1 = C1  (13C' carbonyl carbon)
#   2 = C2  (13Calpha alpha-carbon)
#   3 = N   (15N nitrogen)
#   4 = H   (1H amide proton)
#
# Spin numbering in [16] Table I: spin1=H, spin2=N, spin3=Calpha, spin4=C', spin5=F
# Index map: our 0=F=spin5, 1=C1=C'=spin4, 2=C2=Calpha=spin3, 3=N=spin2, 4=H=spin1
#
# EXACT J-coupling constants from [16] Table I (Marx et al., Phys. Rev. A 60, 2966, 1999):
#   J_12 = 94.1 Hz  (H-N,    1-bond) -> pair (3,4)
#   J_23 = 13.5 Hz  (N-Ca,   1-bond) -> pair (2,3)
#   J_34 = 65.2 Hz  (Ca-C',  1-bond) -> pair (1,2)
#   J_45 = 366.0 Hz (C'-F,   1-bond) -> pair (0,1)
#   J_13 = 2.7 Hz   (H-Ca,   2-bond) -> pair (2,4)
#   J_35 = 67.7 Hz  (Ca-F,   2-bond) -> pair (0,2)
#   J_14, J_15, J_24, J_25: not resolved (>1000)
#
# W formula: W(u,v) = round(10000 / (4 * J_Hz))  [two-qubit]
#            W(u,u) = round(pi*10000 / |min_delta_nu_Hz|) [single-qubit]
#
# Single-qubit W from [16] Table I resonance frequencies (9.4 Tesla, 27 deg C):
#   nu1=400133001.6 Hz(H), nu2=40547895.3 Hz(N),
#   nu3=100616858.0 Hz(Ca), nu4=100629089.1 Hz(C'), nu5=376510545.5 Hz(F)
#   Two 13C spins: |nu4-nu3| = 12231.1 Hz -> W(C1,C1)=W(C2,C2)=round(pi*10000/12231.1)=3
#   H, N, F are each unique in their species -> nearest homonuclear >> 1 MHz away -> W=1
5
# --- Single-qubit weights (from [16] Table I resonance frequencies) ---
single 0  1.0   # F:  unique 19F species, no homonuclear neighbor
single 1  3.0   # C1: |nu_C'  - nu_Ca| = 12231.1 Hz -> W = round(pi*10000/12231.1) = 3
single 2  3.0   # C2: same pair -> W = 3
single 3  1.0   # N:  unique 15N species
single 4  1.0   # H:  unique 1H amide, no homonuclear neighbor
# --- Two-qubit weights (from [16] Table I, exact values) ---
two 0 1    7.0   # F-C1  = J_45 = 366.0 Hz -> W = round(10000/(4*366.0)) = 7
two 3 4   27.0   # N-H   = J_12 = 94.1 Hz  -> W = round(10000/(4*94.1))  = 27
two 0 2   37.0   # F-C2  = J_35 = 67.7 Hz  -> W = round(10000/(4*67.7))  = 37  [2-bond Ca-F]
two 1 2   38.0   # C1-C2 = J_34 = 65.2 Hz  -> W = round(10000/(4*65.2))  = 38
two 2 3  185.0   # C2-N  = J_23 = 13.5 Hz  -> W = round(10000/(4*13.5))  = 185
two 2 4  926.0   # C2-H  = J_13 = 2.7 Hz   -> W = round(10000/(4*2.7))   = 926 [2-bond H-Ca]
two 1 3 9999.0   # C1-N  = not resolved in [16]
two 1 4 9999.0   # C1-H  = not resolved in [16]
two 0 3 9999.0   # F-N   = not resolved in [16]
two 0 4 9999.0   # F-H   = not resolved in [16]
